    {
      "parameters": {
        "jsCode": "// Get the drug name from the loop node (Name matches your canvas)\n// Note: We use .json.drug_name to grab the drug currently being processed\nconst drugName = $node[\"Read Drugs\"].json[\"drug_name\"];\n\n// Get the list of comments from the previous node (Reddit Search)\nconst posts = $input.first().json.data;\n\n// If no posts were found, return empty so it doesn't crash\nif (!posts || posts.length === 0) {\n  return [];\n}\n\n// Convert each Reddit post into a separate item\nreturn posts.map(post => ({\n  json: {\n    text: post.body,\n    drug_name: drugName,\n    source: \"Reddit/r/\" + post.subreddit,\n    id: post.id\n  }\n}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1376,
        0
      ],
      "id": "ac775b20-b687-429d-9854-4d64bc17e6f1",
      "name": "Split comments"
